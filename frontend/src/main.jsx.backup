import React,{useEffect,useState} from "react"; import {createRoot} from "react-dom/client"; import {BrowserRouter,useNavigate,useParams,Link,NavLink,Routes,Route,Navigate} from "react-router-dom"; import axios from "axios"; import {BookOpen,Bot,ChevronRight,LogOut,Menu,X,LayoutDashboard,GraduationCap,UserRound,Shield,PlusCircle,Send,Sparkles,PlayCircle,ArrowLeft,Search,Mail,Lock} from "lucide-react"; import "./styles.css";
const api=axios.create({baseURL:import.meta.env.VITE_API_URL||"http://127.0.0.1:8000/api/v1"}); api.interceptors.request.use(c=>{const t=localStorage.getItem("lms_token");if(t)c.headers.Authorization=`Bearer ${t}`;return c}); const err=e=>{let d=e?.response?.data?.detail;return Array.isArray(d)?d.map(x=>x.msg).join(", "):d||e?.message||"Request failed"};
function useAuth(){const [token,setToken]=useState(localStorage.getItem("lms_token"));const [user,setUser]=useState(()=>{try{return JSON.parse(localStorage.getItem("lms_user"))}catch{return null}});useEffect(()=>{if(token)api.get("/auth/me").then(r=>{setUser(r.data);localStorage.setItem("lms_user",JSON.stringify(r.data))}).catch(()=>{localStorage.clear();setToken(null);setUser(null)})},[token]);const login=async(f)=>{const r=await api.post("/auth/login",f);const t=r.data.access_token||r.data.token;if(!t)throw Error("No access token returned");localStorage.setItem("lms_token",t);setToken(t);const m=await api.get("/auth/me");setUser(m.data);localStorage.setItem("lms_user",JSON.stringify(m.data))};const logout=()=>{localStorage.clear();setToken(null);setUser(null)};return {token,user,login,logout}};
const Btn=({children,...p})=><button className="btn btn-primary" {...p}>{children}</button>; const Card=({c,go})=><div className="course"><div className="cover">{c.thumbnail_url?<img src={c.thumbnail_url}/>:<b>AI</b>}<span>{c.category||"General"}</span></div><div className="cp"><small>{c.difficulty||"beginner"} · {c.price?`₹${c.price}`:"Free"}</small><h3>{c.title}</h3><p>{c.description||"Structured learning with AI support."}</p><button className="btn btn-primary full" onClick={()=>go(c.id)}>View course</button></div></div>;
function Layout({user,logout}){const [open,setOpen]=useState(false);const role=(user?.role?.name||user?.role||"student").toLowerCase();const nav=[["/dashboard","Dashboard",LayoutDashboard],["/courses","Courses",BookOpen],["/learning","My Learning",GraduationCap],["/ai-tutor","AI Tutor",Bot],["/profile","Profile",UserRound]];if(role==="instructor"||role==="admin")nav.push(["/instructor","Instructor",PlusCircle]);if(role==="admin")nav.push(["/admin","Admin",Shield]);return <div className="shell"><aside className={open?"side open":"side"}><div className="brand"><span className="logo"><Bot/></span><b>LMS-AI</b><button className="x" onClick={()=>setOpen(false)}><X/></button></div><small className="label">MAIN MENU</small>{nav.map(([to,t,I])=><NavLink onClick={()=>setOpen(false)} className={({isActive})=>isActive?"nav active":"nav"} to={to} key={to}><I/><span>{t}</span></NavLink>)}<div className="sidebottom"><div className="mini"><span>{(user?.full_name||"U")[0]}</span><div><b>{user?.full_name||"User"}</b><small>{role}</small></div></div><button className="logout" onClick={logout}><LogOut/> Sign out</button></div></aside>{open&&<div className="overlay" onClick={()=>setOpen(false)}/>}<main className="main"><header><button className="hamb" onClick={()=>setOpen(true)}><Menu/></button><div><small>LEARNING MANAGEMENT SYSTEM</small><b>Learn smarter with AI</b></div><Link className="topavatar" to="/profile">{(user?.full_name||"U")[0]}</Link></header><section className="content"><OutletShim/></section></main></div>}
let outlet=null; function OutletShim(){return outlet}
function Protected({children}){const a=useAuth();if(!a.token)return <Navigate to="/login" replace/>;return children({user:a.user,logout:a.logout})}
function Auth({register=false}){const a=useAuth();const nav=useNavigate();const [f,setF]=useState(register?{full_name:"",email:"",password:""}:{email:"student@lmsai.local",password:"Student@123"});const [e,setE]=useState("");const submit=async x=>{x.preventDefault();setE("");try{if(register){await api.post("/auth/register",f);nav("/login")}else{await a.login(f);nav("/dashboard")}}catch(z){setE(err(z))}};return <div className="auth"><div className="visual"><div className="brand"><span className="logo"><Bot/></span><b>LMS-AI</b></div><h1>Learn at your pace.<br/><em>Think with AI.</em></h1><p>Courses, progress tracking and an intelligent tutor in one place.</p></div><div className="authbox"><div className="brand"><span className="logo"><Bot/></span><b>LMS-AI</b></div><h2>{register?"Create your account":"Welcome back"}</h2><p>{register?"Start your learning journey.":"Sign in to continue learning."}</p>{e&&<div className="alert">{e}</div>}<form onSubmit={submit}>{register&&<label>Full name<input required value={f.full_name} onChange={x=>setF({...f,full_name:x.target.value})}/></label>}<label>Email<input type="email" required value={f.email} onChange={x=>setF({...f,email:x.target.value})}/></label><label>Password<input type="password" required value={f.password} onChange={x=>setF({...f,password:x.target.value})}/></label><Btn>{register?"Create account":"Sign in"}</Btn></form>{!register&&<small className="demo">Demo: student@lmsai.local / Student@123</small>}<p className="switch">{register?<>Already have an account? <Link to="/login">Sign in</Link></>:<>New here? <Link to="/register">Create an account</Link></>}</p></div></div>}
function Dashboard({user}){const [cs,setCs]=useState([]),[es,setEs]=useState([]);useEffect(()=>{Promise.allSettled([api.get("/courses"),api.get("/enrollments/me")]).then(([a,b])=>{if(a.status==="fulfilled")setCs(a.value.data.items||a.value.data||[]);if(b.status==="fulfilled")setEs(b.value.data.items||b.value.data||[])})},[]);return <><div className="hero"><small>GOOD TO SEE YOU</small><h2>Hi, {user?.full_name?.split(" ")[0]||"Learner"} 👋</h2><p>Keep building your skills. Your next lesson is waiting.</p><div><Link className="btn light" to="/courses">Explore courses <ChevronRight/></Link><Link className="btn ghost" to="/ai-tutor"><Sparkles/> Ask AI Tutor</Link></div></div><div className="stats"><Stat t="Enrolled courses" v={es.length}/><Stat t="Available courses" v={cs.length}/><Stat t="Learning streak" v="0 days"/><Stat t="Certificates" v="0"/></div><div className="sectionhead"><div><small>DISCOVER</small><h2>Featured courses</h2></div><Link to="/courses">View all →</Link></div><div className="grid">{cs.slice(0,3).map(c=><Card c={c} key={c.id} go={id=>location.href=`/courses/${id}`}/>)}</div></>}; function Stat({t,v}){return <div className="stat"><span>{t}</span><b>{v}</b><small>Keep learning</small></div>}
function Courses(){const [cs,setCs]=useState([]),[q,setQ]=useState("");const nav=useNavigate();useEffect(()=>{api.get("/courses").then(r=>setCs(r.data.items||r.data||[])).catch(()=>{})},[]);const f=cs.filter(c=>(c.title||"").toLowerCase().includes(q.toLowerCase())||(c.category||"").toLowerCase().includes(q.toLowerCase()));return <><div className="title"><small>COURSE CATALOG</small><h2>Explore courses</h2><p>Build practical skills with structured lessons.</p></div><div className="search"><Search/><input placeholder="Search courses..." value={q} onChange={e=>setQ(e.target.value)}/></div><div className="grid">{f.map(c=><Card c={c} key={c.id} go={id=>nav(`/courses/${id}`)}/>)}</div>{!f.length&&<div className="empty">No courses found.</div>}</>}
function Course(){const {courseId}=useParams();const [c,setC]=useState(null),[ms,setMs]=useState([]),[open,setOpen]=useState({});const [e,setE]=useState("");useEffect(()=>{Promise.all([api.get(`/courses/${courseId}`),api.get(`/courses/${courseId}/modules`).catch(()=>({data:[]}))]).then(([a,b])=>{setC(a.data);setMs(b.data.items||b.data||a.data.modules||[])}).catch(z=>setE(err(z)))},[courseId]);if(e)return <div className="alert">{e}</div>;if(!c)return <div className="loading">Loading...</div>;return <><Link to="/courses" className="back"><ArrowLeft/> Back to courses</Link><div className="detail"><div><span className="pill">{c.category||"Course"}</span><h2>{c.title}</h2><p>{c.description}</p><Btn onClick={async()=>{try{await api.post(`/courses/${courseId}/enroll`);alert("Enrolled successfully") }catch(z){alert(err(z))}}}>Enroll now</Btn></div><BookOpen size={90}/></div><div className="sectionhead"><div><small>CURRICULUM</small><h2>Course modules</h2></div></div>{ms.map((m,i)=><div className="module" key={m.id||i}><button onClick={()=>setOpen({...open,[m.id||i]:!open[m.id||i]})}><b>{i+1}</b><span><strong>{m.title||`Module ${i+1}`}</strong><small>{(m.lectures||[]).length} lessons</small></span><ChevronRight/></button>{open[m.id||i]&&(m.lectures||[]).map((l,j)=><Link className="lecture" key={l.id||j} to={`/courses/${courseId}/lecture/${l.id}`}><PlayCircle/> {l.title||`Lecture ${j+1}`}</Link>))}</div>)}</>}
function Lecture(){const {lectureId}=useParams();const [l,setL]=useState(null);useEffect(()=>{api.get(`/lectures/${lectureId}`).then(r=>setL(r.data)).catch(()=>{})},[lectureId]);if(!l)return <div className="loading">Loading...</div>;let v=l.video_url||"";v=v.replace("watch?v=","embed/");return <><Link to={-1} className="back"><ArrowLeft/> Back</Link><div className="player"><div><div className="video">{v?<iframe src={v} title={l.title} allowFullScreen/>:<PlayCircle size={50}/>}</div><h2>{l.title}</h2><p>{l.description}</p></div><div className="panel"><h3>Transcript</h3><p>{l.transcript||"No transcript available."}</p><Btn>Mark complete</Btn></div></div></>}
function Learning(){const [es,setEs]=useState([]);useEffect(()=>{api.get("/enrollments/me").then(r=>setEs(r.data.items||r.data||[])).catch(()=>{})},[]);return <><div className="title"><small>YOUR PROGRESS</small><h2>My learning</h2><p>Pick up where you left off.</p></div><div className="learninggrid">{es.map((e,i)=><div className="panel" key={e.id||i}><BookOpen/><h3>{e.course?.title||e.course_title||`Course #${e.course_id}`}</h3><small>Progress {e.progress||0}%</small><div className="progress"><i style={{width:`${e.progress||0}%`}}/></div><Link to={e.course_id?`/courses/${e.course_id}`:"/courses"}>Continue →</Link></div>)}</div>{!es.length&&<div className="empty">Enroll in a course to start learning.</div>}</>}
function AI(){const [m,setM]=useState([{r:"ai",t:"Hi! I'm your LMS-AI tutor. Ask me about a course or concept."}]),[x,setX]=useState("");const send=()=>{if(!x.trim())return;const q=x;setX("");setM(a=>[...a,{r:"u",t:q},{r:"ai",t:"The tutor interface is ready. Connect this chat to your Ollama/Groq backend endpoint when the AI route is available."}])};return <><div className="title"><small>AI LEARNING ASSISTANT</small><h2>AI Tutor</h2><p>Get explanations and study guidance.</p></div><div className="chat panel"><div className="messages">{m.map((z,i)=><div className={z.r==="u"?"msg user":"msg"} key={i}><span>{z.r==="u"?<UserRound/>:<Bot/>}</span><p>{z.t}</p></div>)}</div><div className="chatinput"><input value={x} onChange={e=>setX(e.target.value)} onKeyDown={e=>e.key==="Enter"&&send()} placeholder="Ask anything..."/><button onClick={send}><Send/></button></div></div></>}
function Profile({user}){return <><div className="title"><small>ACCOUNT</small><h2>Profile</h2></div><div className="profile panel"><div className="bigavatar">{(user?.full_name||"U")[0]}</div><h2>{user?.full_name||"Learner"}</h2><span>{user?.email||"—"}</span><p>Role: {user?.role?.name||user?.role||"student"}</p></div></>}
function Simple({kind}){return <><div className="title"><small>{kind.toUpperCase()}</small><h2>{kind}</h2><p>This section is ready for the corresponding backend endpoints.</p></div><div className="panel"><h3>{kind} workspace</h3><p>Connect the dedicated FastAPI endpoints here as they are implemented.</p></div></>}
function App(){const auth=useAuth();return <Routes><Route path="/login" element={auth.token?<Navigate to="/dashboard"/>:<Auth/>}/><Route path="/register" element={auth.token?<Navigate to="/dashboard"/>:<Auth register/>}/><Route path="*" element={auth.token?<Shell auth={auth}/>:<Navigate to="/login"/>}/></Routes>}
function Shell({auth}){const {user,logout}=auth;const path=location.pathname;let page=path==="/dashboard"?<Dashboard user={user}/>:path==="/courses"?<Courses/>:path==="/learning"?<Learning/>:path==="/ai-tutor"?<AI/>:path==="/profile"?<Profile user={user}/>:path==="/instructor"?<Simple kind="Instructor"/>:path==="/admin"?<Simple kind="Admin"/>:path.startsWith("/courses/")&&path.includes("/lecture/")?<Lecture/>:path.startsWith("/courses/")?<Course/>:<Dashboard user={user}/>;outlet=page;return <Layout user={user} logout={logout}/>}
createRoot(document.getElementById("root")).render(<React.StrictMode><BrowserRouter><App/></BrowserRouter></React.StrictMode>);